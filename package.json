{
  "name": "it-learning-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "validate:syllabus": "vitest run test/syllabus.test.ts",
    "validate:questions": "vitest run test/questionBank.test.ts test/pastExamQuestions.test.ts test/pastExamAttempts.test.ts test/questionQuality.test.ts test/questionQualityMetrics.test.ts test/checkPackOfficialQuestions.test.ts test/questionVersionDiff.test.ts test/questionBlueprint.test.ts test/questionAttemptSanitize.test.ts test/questionAttemptsDuplicateSave.test.ts test/questionAttemptsSchema.test.ts test/TopicQuizOfficialQuestion.test.tsx",
    "validate:question-versions": "node scripts/question-bank/validate-version-bump.mjs",
    "questions:migrate": "node scripts/question-bank/migrate-exam-level.mjs",
    "questions:import:ipa": "node scripts/question-bank/import-ipa-it-passport.mjs",
    "questions:import:candidates": "node scripts/question-bank/import-candidates.mjs",
    "questions:blueprint": "node scripts/question-bank/blueprint.mjs",
    "validate:blueprints": "node scripts/question-bank/blueprint.mjs validate",
    "questions:quality-report": "node scripts/question-bank/quality-report.mjs",
    "questions:analyze-quality": "node scripts/question-bank/analyze-quality.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "richmenu:preview": "node scripts/richmenu/richmenu-image.mjs",
    "richmenu:setup": "node scripts/richmenu/setup-richmenu.mjs",
    "questions:apply-revision": "node scripts/question-bank/apply-revision.mjs",
    "questions:build:theme-exam": "node scripts/question-bank/build-theme-exam.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@rive-app/react-canvas": "^4.29.5",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
